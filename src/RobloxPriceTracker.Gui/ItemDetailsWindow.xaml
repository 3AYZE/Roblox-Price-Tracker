<Window x:Class="RobloxPriceTracker.Gui.ItemDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RobloxPriceTracker.Gui"
        Icon="Assets/mouse_app.ico"
        Title="Asset details"
        Width="1120" Height="890"
        MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <Border Background="#0C1117" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Width="52" Height="52" VerticalAlignment="Center">
                    <Border Background="#141C26" BorderBrush="#263242" BorderThickness="1" CornerRadius="4" />
                    <Image x:Name="ItemThumbnail" Stretch="UniformToFill" Margin="3" />
                    <TextBlock x:Name="ItemThumbnailFallback" Text="R" Foreground="#6E7B8C" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,18,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ItemNameText" Text="Item" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border x:Name="ItemStatusBadge" Background="#151C25" CornerRadius="3" Padding="8,3" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ItemStatusText" Text="Waiting" Foreground="#98A5B5" FontSize="8.5" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ItemMetaText" Foreground="{StaticResource TextSecondary}" FontSize="9.5" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="OPEN ON ROBLOX" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="OpenRoblox_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}"><StackPanel><TextBlock Text="LAST" Style="{StaticResource SectionLabelStyle}" /><TextBlock x:Name="CurrentPriceText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock x:Name="TargetDistanceText" Text="Target unavailable" Foreground="{StaticResource TextTertiary}" FontSize="8.5" Margin="0,4,0,0" /></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource CompactCardStyle}"><StackPanel><TextBlock Text="TARGET" Style="{StaticResource SectionLabelStyle}" /><TextBlock x:Name="TargetPriceText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="Alert threshold" Foreground="{StaticResource TextTertiary}" FontSize="8.5" Margin="0,4,0,0" /></StackPanel></Border>
                    <Border Grid.Column="4" Style="{StaticResource CompactCardStyle}"><StackPanel><TextBlock Text="SESSION LOW" Style="{StaticResource SectionLabelStyle}" /><TextBlock x:Name="TrackedLowText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="Lowest observed" Foreground="{StaticResource TextTertiary}" FontSize="8.5" Margin="0,4,0,0" /></StackPanel></Border>
                    <Border Grid.Column="6" Style="{StaticResource CompactCardStyle}"><StackPanel><TextBlock Text="UPDATED" Style="{StaticResource SectionLabelStyle}" /><TextBlock x:Name="LastCheckedText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,9,0,0" /><TextBlock x:Name="ObservationCountText" Text="0 observations" Foreground="{StaticResource TextTertiary}" FontSize="8.5" Margin="0,4,0,0" /></StackPanel></Border>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CompactCardStyle}"><StackPanel><TextBlock Text="RANGE LOW" Style="{StaticResource SectionLabelStyle}" /><TextBlock x:Name="RangeLowText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource CompactCardStyle}"><StackPanel><TextBlock Text="RANGE HIGH" Style="{StaticResource SectionLabelStyle}" /><TextBlock x:Name="RangeHighText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                    <Border Grid.Column="4" Style="{StaticResource CompactCardStyle}"><StackPanel><TextBlock Text="RANGE CHANGE" Style="{StaticResource SectionLabelStyle}" /><TextBlock x:Name="RangeChangeText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="MARKET FORECAST" Foreground="#D8E2EC" FontSize="10.5" FontWeight="SemiBold" />
                                <TextBlock Text="Statistical estimate from lowest-listing history plus Roblox RAP and daily sales volume when available. Not a guaranteed future price." Foreground="#667383" FontSize="8.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#121A24" BorderBrush="#273545" BorderThickness="1" CornerRadius="3" Padding="9,4" Margin="12,0,0,0" VerticalAlignment="Top">
                                <TextBlock x:Name="ForecastDirectionText" Text="WAITING" Foreground="#8A98A8" FontSize="8.5" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="NEXT PRICE" Style="{StaticResource SectionLabelStyle}"/><TextBlock x:Name="ForecastPriceText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="ForecastRangeText" Text="Insufficient data" Foreground="#6F7C8D" FontSize="8.2" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="FAIR VALUE" Style="{StaticResource SectionLabelStyle}"/><TextBlock x:Name="ForecastFairValueText" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="CONF" Style="{StaticResource SectionLabelStyle}"/><TextBlock x:Name="ForecastConfidenceText" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="RAP" Style="{StaticResource SectionLabelStyle}"/><TextBlock x:Name="ForecastRapText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="SALES/D" Style="{StaticResource SectionLabelStyle}"/><TextBlock x:Name="ForecastSalesText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                            <StackPanel Grid.Column="5"><TextBlock Text="LIQUIDITY" Style="{StaticResource SectionLabelStyle}"/><TextBlock x:Name="ForecastLiquidityText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                        </Grid>

                        <Border Height="1" Background="#202A36" Margin="0,13,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="TARGET 1H" Style="{StaticResource SectionLabelStyle}"/><TextBlock x:Name="ForecastTarget1hText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="TARGET 6H" Style="{StaticResource SectionLabelStyle}"/><TextBlock x:Name="ForecastTarget6hText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="TARGET 24H" Style="{StaticResource SectionLabelStyle}"/><TextBlock x:Name="ForecastTarget24hText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="EST. TIME TO TARGET" Style="{StaticResource SectionLabelStyle}"/><TextBlock x:Name="ForecastEtaText" Text="—" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="BACKTEST" Style="{StaticResource SectionLabelStyle}"/><TextBlock x:Name="ForecastAccuracyText" Text="Learning" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="ForecastStatusText" Text="Waiting for data" Foreground="#667383" FontSize="7.8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="8" Margin="0,12,0,0" Height="310">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="7,0,0,0"><TextBlock Text="PRICE HISTORY" Foreground="#C8D2DE" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="Lowest reseller observations" Foreground="#5E6B7B" FontSize="8.5" Margin="0,2,0,0" /></StackPanel>
                        <ComboBox x:Name="DetailRangeCombo" Width="140" HorizontalAlignment="Right" SelectedIndex="2" SelectionChanged="DetailRangeCombo_SelectionChanged">
                            <ComboBoxItem Content="1 Hour" Tag="1H" />
                            <ComboBoxItem Content="24 Hours" Tag="24H" />
                            <ComboBoxItem Content="7 Days" Tag="7D" />
                            <ComboBoxItem Content="30 Days" Tag="30D" />
                            <ComboBoxItem Content="All History" Tag="All" />
                        </ComboBox>
                        <local:PriceChart x:Name="DetailPriceChart" Grid.Row="1" />
                    </Grid>
                </Border>

                <TextBlock Text="RECENT OBSERVATIONS" Style="{StaticResource SectionLabelStyle}" Margin="0,15,0,8" />
                <DataGrid x:Name="DetailHistoryGrid" Height="205" IsReadOnly="True" AlternationCount="2" RowHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="1.6*" />
                        <DataGridTextColumn Header="PRICE" Binding="{Binding Price}" Width="1.2*" />
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0C1117" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="9.5" />
                <Button Content="CLOSE" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Click="Close_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
