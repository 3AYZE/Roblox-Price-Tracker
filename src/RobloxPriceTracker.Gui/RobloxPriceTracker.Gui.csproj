<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>RobloxPriceTracker</AssemblyName>
    <RootNamespace>RobloxPriceTracker.Gui</RootNamespace>
    <Version>0.6.3</Version>
    <AssemblyVersion>0.6.3.0</AssemblyVersion>
    <FileVersion>0.6.3.0</FileVersion>
    <ApplicationIcon>Assets\mouse_app.ico</ApplicationIcon>
    <Authors>3AYZE</Authors>
    <Company>3AYZE</Company>
    <Description>Professional Windows Roblox Limited resale market monitor with statistical price forecasts, liquidity analytics, stock-style quotes, targets, history, alerts, automatic updates, and background tracking.</Description>
    <Product>Roblox Price Tracker</Product>
    <Title>Roblox Price Tracker</Title>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\mouse_logo.png" />
    <Resource Include="Assets\mouse_menu.png" />
    <Resource Include="Assets\mouse_window.png" />
    <Resource Include="Assets\mouse_app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RobloxPriceTracker.Core\RobloxPriceTracker.Core.csproj" />
    <ProjectReference Include="..\RobloxPriceTracker.Infrastructure\RobloxPriceTracker.Infrastructure.csproj" />
  </ItemGroup>
</Project>
