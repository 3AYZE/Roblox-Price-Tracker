<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>RobloxPriceTracker</AssemblyName>
    <RootNamespace>RobloxPriceTracker.Gui</RootNamespace>
    <Version>0.14.2</Version>
    <AssemblyVersion>0.14.2.0</AssemblyVersion>
    <FileVersion>0.14.2.0</FileVersion>
    <ApplicationIcon>Assets\mouse_app.ico</ApplicationIcon>
    <Authors>3AYZE</Authors>
    <Company>3AYZE</Company>
    <Description>Track Roblox Limited resale prices, discover qualifying UGC Limiteds, and get price alerts with a Windows desktop app.</Description>
    <Product>Roblox Price Tracker</Product>
    <Title>Roblox Price Tracker</Title>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <Target Name="GenerateTrackerBrandAssets" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\Generate-BrandAssets.ps1&quot;" />
  </Target>
  <ItemGroup>
    <Resource Include="Assets\mouse_logo.png" />
    <Resource Include="Assets\mouse_menu.png" />
    <Resource Include="Assets\mouse_window.png" />
    <Resource Include="Assets\mouse_app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RobloxPriceTracker.Core\RobloxPriceTracker.Core.csproj" />
    <ProjectReference Include="..\RobloxPriceTracker.Infrastructure\RobloxPriceTracker.Infrastructure.csproj" />
  </ItemGroup>
</Project>
