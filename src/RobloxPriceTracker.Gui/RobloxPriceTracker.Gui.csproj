<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>RobloxPriceTracker</AssemblyName>
    <RootNamespace>RobloxPriceTracker.Gui</RootNamespace>
    <Version>0.12.2</Version>
    <AssemblyVersion>0.12.2.0</AssemblyVersion>
    <FileVersion>0.12.2.0</FileVersion>
    <ApplicationIcon Condition="'$(RPTEmbedIcon)' == 'true'">Assets\mouse_app.ico</ApplicationIcon>
    <Authors>3AYZE</Authors>
    <Company>3AYZE</Company>
    <Description>Roblox Market Helper: a clean Windows Roblox Limited market terminal with Official Hunt, UGC Hunter, tracking, stock-style market signals, smart target notifications, research, paper portfolio, alerts, resilient local data backups, and background monitoring.</Description>
    <Product>Roblox Market Helper</Product>
    <Title>Roblox Market Helper</Title>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="UgcHunterService.cs" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\mouse_logo.png" />
    <Resource Include="Assets\mouse_menu.png" />
    <Resource Include="Assets\mouse_window.png" />
    <Resource Include="Assets\mouse_app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RobloxPriceTracker.Core\RobloxPriceTracker.Core.csproj" />
    <ProjectReference Include="..\RobloxPriceTracker.Infrastructure\RobloxPriceTracker.Infrastructure.csproj" />
  </ItemGroup>
</Project>