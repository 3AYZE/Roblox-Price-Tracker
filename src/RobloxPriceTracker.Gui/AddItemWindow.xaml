<Window x:Class="RobloxPriceTracker.Gui.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/mouse_app.ico"
        Title="Add item"
        Width="650" Height="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="26,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitleText" Text="Add watchlist item" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="DialogSubtitleText" Text="Verify the Roblox item first, then choose the price you want to be alerted at." Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,4,0,0" />
                </StackPanel>
                <Border Width="38" Height="38" CornerRadius="9" Background="#EFF4FF" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,22,26,24">
                <TextBlock Text="Roblox item" FontSize="11.5" FontWeight="SemiBold" />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="118" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="ItemInputTextBox" TextChanged="ItemInputTextBox_TextChanged" />
                    <Button x:Name="VerifyButton" Grid.Column="2" Content="Verify Item" Style="{StaticResource SecondaryButtonStyle}" Click="VerifyButton_Click" />
                </Grid>
                <TextBlock Text="Paste an asset ID or a roblox.com/catalog URL." Foreground="{StaticResource TextTertiary}" FontSize="10" Margin="0,5,0,0" />

                <Border x:Name="ResolvedItemPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="16" Margin="0,18,0,0" Background="#FFFFFF">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Width="64" Height="64" VerticalAlignment="Top">
                            <Border Background="#F2F4F7" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="9" />
                            <Image x:Name="ResolvedThumbnail" Stretch="UniformToFill" Margin="3" />
                            <TextBlock x:Name="ResolvedThumbnailFallback" Text="R" Foreground="#98A2B3" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,12,0">
                            <TextBlock x:Name="ResolvedNameText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ResolvedAssetIdText" Foreground="{StaticResource TextTertiary}" FontSize="10" Margin="0,3,0,0" />
                            <TextBlock x:Name="ResolvedPriceText" FontSize="11.5" FontWeight="SemiBold" Margin="0,9,0,0" />
                        </StackPanel>
                        <Border x:Name="ResolvedStatusBadge" Grid.Column="2" Background="#ECFDF3" CornerRadius="10" Padding="9,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock x:Name="ResolvedStatusText" Text="Verified" Foreground="#067647" FontSize="9.5" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#FEF3F2" BorderBrush="#FECDCA" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#B42318" FontSize="12" VerticalAlignment="Top" Margin="1,2,0,0" />
                        <TextBlock x:Name="ErrorText" Grid.Column="1" Foreground="#912018" FontSize="10.5" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,20,0,18" />

                <TextBlock Text="Target price" FontSize="11.5" FontWeight="SemiBold" />
                <TextBox x:Name="TargetPriceTextBox" Margin="0,7,0,0" />
                <TextBlock Text="Whole Robux amount. The alert triggers when the current lowest reseller price reaches or drops below this value." Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />

                <Border Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#667085" FontSize="13" VerticalAlignment="Top" Margin="1,2,0,0" />
                        <TextBlock Grid.Column="1" Text="The tracker monitors lowest reseller listings only. Missing sellers or API failures are never treated as a 0 R$ price." Foreground="{StaticResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="26,0">
            <Grid>
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="CancelButton_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="BusyText" Text="" Foreground="{StaticResource TextSecondary}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="SaveButton" Content="Add to Watchlist" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
