<Window x:Class="RobloxPriceTracker.Gui.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/mouse_app.ico"
        Title="Track asset"
        Width="650" Height="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="66" />
        </Grid.RowDefinitions>

        <Border Background="#0C1117" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitleText" Text="Track market asset" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="DialogSubtitleText" Text="Verify the Roblox asset, then set the price level you want monitored." Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
                <Border Width="34" Height="34" CornerRadius="4" Background="#111A26" BorderBrush="#26374A" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#64A8FF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,22">
                <TextBlock Text="ASSET" Style="{StaticResource SectionLabelStyle}" />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="9" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="ItemInputTextBox" TextChanged="ItemInputTextBox_TextChanged" />
                    <Button x:Name="VerifyButton" Grid.Column="2" Content="VERIFY" Style="{StaticResource SecondaryButtonStyle}" Click="VerifyButton_Click" />
                </Grid>
                <TextBlock Text="Paste an asset ID or roblox.com/catalog URL." Foreground="{StaticResource TextTertiary}" FontSize="9" Margin="0,5,0,0" />

                <Border x:Name="ResolvedItemPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="14" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Width="58" Height="58" VerticalAlignment="Top">
                            <Border Background="#141C26" BorderBrush="#263242" BorderThickness="1" CornerRadius="4" />
                            <Image x:Name="ResolvedThumbnail" Stretch="UniformToFill" Margin="3" />
                            <TextBlock x:Name="ResolvedThumbnailFallback" Text="R" Foreground="#6E7B8C" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,12,0">
                            <TextBlock x:Name="ResolvedNameText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ResolvedAssetIdText" Foreground="{StaticResource TextTertiary}" FontSize="9" Margin="0,3,0,0" />
                            <TextBlock x:Name="ResolvedPriceText" Foreground="#DCE4EC" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                        <Border x:Name="ResolvedStatusBadge" Grid.Column="2" Background="#0D281B" CornerRadius="3" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock x:Name="ResolvedStatusText" Text="Verified" Foreground="#2DD881" FontSize="8.5" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#2A1417" BorderBrush="#573038" BorderThickness="1" CornerRadius="4" Padding="11" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#FF7777" FontSize="11" VerticalAlignment="Top" Margin="1,2,0,0" />
                        <TextBlock x:Name="ErrorText" Grid.Column="1" Foreground="#FF9999" FontSize="9.5" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,18,0,16" />

                <TextBlock Text="TARGET PRICE" Style="{StaticResource SectionLabelStyle}" />
                <TextBox x:Name="TargetPriceTextBox" Margin="0,7,0,0" />
                <TextBlock Text="The signal triggers when the current lowest reseller price reaches or falls below this level." Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap" />

                <Border Background="#0D131A" BorderBrush="#1F2A37" BorderThickness="1" CornerRadius="4" Padding="11" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#6F7D8E" FontSize="12" VerticalAlignment="Top" Margin="1,2,0,0" />
                        <TextBlock Grid.Column="1" Text="Only lowest reseller listings are monitored. Missing sellers and API failures are never treated as 0 R$." Foreground="{StaticResource TextSecondary}" FontSize="9.5" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0C1117" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid>
                <Button Content="CANCEL" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="CancelButton_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="BusyText" Text="" Foreground="{StaticResource TextSecondary}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,11,0" />
                    <Button x:Name="SaveButton" Content="ADD TO WATCHLIST" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
